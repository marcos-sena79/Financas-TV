{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/tv", "destination": "/tv.html" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 11 * * *" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  }
}
